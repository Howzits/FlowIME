{
  "name": "codex-terminal-auto-input",
  "displayName": "FlowIME",
  "description": "%description%",
  "version": "0.5.0",
  "publisher": "ContextIME",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Howzits/ContextIME.git"
  },
  "homepage": "https://github.com/Howzits/ContextIME#readme",
  "bugs": {
    "url": "https://github.com/Howzits/ContextIME/issues"
  },
  "keywords": [
    "ime",
    "input method",
    "chinese",
    "terminal",
    "chat",
    "输入法",
    "中英切换"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/extension.test.js",
    "build": "pwsh -NoProfile -File build.ps1",
    "verify-package": "python scripts/verify_package.py"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "autoInput.toggle",
        "title": "%autoInput.toggle.title%"
      },
      {
        "command": "autoInput.showLog",
        "title": "%autoInput.showLog.title%"
      },
      {
        "command": "autoInput.restart",
        "title": "%autoInput.restart.title%"
      },
      {
        "command": "autoInput.diagnose",
        "title": "%autoInput.diagnose.title%"
      },
      {
        "command": "autoInput.preferEnglish",
        "title": "%autoInput.preferEnglish.title%"
      },
      {
        "command": "autoInput.preferChinese",
        "title": "%autoInput.preferChinese.title%"
      },
      {
        "command": "autoInput.preferKeep",
        "title": "%autoInput.preferKeep.title%"
      },
      {
        "command": "autoInput.clearPreferences",
        "title": "%autoInput.clearPreferences.title%"
      }
    ],
    "configuration": {
      "title": "FlowIME",
      "properties": {
        "autoInput.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%autoInput.enabled.description%"
        },
        "autoInput.rememberPreferences": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%autoInput.rememberPreferences.description%"
        },
        "autoInput.otherInputs": {
          "type": "string",
          "enum": [
            "chinese",
            "preserve"
          ],
          "default": "chinese",
          "scope": "application",
          "description": "%autoInput.otherInputs.description%"
        },
        "autoInput.pollInterval": {
          "type": "integer",
          "default": 100,
          "minimum": 50,
          "maximum": 1000,
          "scope": "application",
          "description": "%autoInput.pollInterval.description%"
        }
      }
    }
  },
  "l10n": "./l10n",
  "author": "haochen12"
}
